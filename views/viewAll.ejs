<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/cards.css">
    <link rel="stylesheet" href="/css/viewAll.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Livvic:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,900&display=swap"
        rel="stylesheet">
    <title>EXTRAALAYER | All Products</title>

    <!-- JSON-LD Collection Schema -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "CollectionPage",
      "name": "Shop All Men's Streetwear",
      "description": "Browse the full collection of EXTRAALAYER premium streetwear for men. Oversized t-shirts, hoodies, acid wash, and anime prints.",
      "url": "https://extraalayer.com/viewAll",
      "brand": {
        "@type": "Brand",
        "name": "EXTRAALAYER"
      }
    }
    </script>
</head>

<body>
    <div>
        <%- include('partials/nav_bar') %>
    </div>

    <div class="view-all">
        <!-- Premium Products Section -->
        <div class="premium-products">
            <!-- <h2>Premium Products</h2> -->
            <div class="row">
                <% premiumProducts.slice(0, 2).forEach((Product, index)=> { %>
                    <div class="card-container">
                        <a href="/product/<%= Product._id %>">
                            <div class="card" id="interactive-card<%=index + 1 %>">
                                <img src="<%= Product.images[0]%>" class="card-image active"
                                    id="default<%= index + 1 %> " alt="Default image">
                                <img src="<%= Product.images[1]%>" class="card-image" id="image<%= index + 1 %>_1"
                                    alt="Product Image 1">
                                <img src="<%= Product.images[2]%>" class="card-image" id="image<%= index + 1 %>_2"
                                    alt="Product Image 2">
                                <img src="<%= Product.images[3]%>" class="card-image" id="image<%= index+1 %>_3"
                                    alt="Product Image 3">
                                <div class="dot-navigation">
                                    <span class="dot" data-index="0"></span>
                                    <span class="dot" data-index="1"></span>
                                    <span class="dot" data-index="2"></span>
                                </div>
                                <div class="text-overlay">
                                    <h3>
                                        <%= Product.productName %>
                                    </h3>
                                    <div class="prices">
                                        <% if (Product.discountedPercentage> 0) { %>
                                            <span class="current-price">₹ <%= Product.discountedPrice %></span>
                                            <span class="original-price">₹ <%= Product.originalPrice %></span>
                                            <% } else { %>
                                                <span class="current-price">₹ <%= Product.originalPrice %></span>
                                                <% } %>
                                    </div>
                                </div>
                            </div>
                        </a>
                    </div>
                    <% }); %>
            </div>
        </div>

        <!-- Mid-Range Products Section -->
        <div class="mid-range-products">
            <!-- <h2>Mid-Range Products</h2> -->
            <div class="row">
                <% midRangeProducts.slice(0, 2).forEach((Product, index)=> { %>
                    <div class="card-container">
                        <a href="/product/<%= Product._id %>">
                            <div class="card" id="interactive-card<%=index + 1 %>">
                                <img src="<%= Product.images[0]%>" class="card-image active"
                                    id="default<%= index + 1 %> " alt="Default image">
                                <img src="<%= Product.images[1]%>" class="card-image" id="image<%= index + 1 %>_1"
                                    alt="Product Image 1">
                                <img src="<%= Product.images[2]%>" class="card-image" id="image<%= index + 1 %>_2"
                                    alt="Product Image 2">
                                <img src="<%= Product.images[3]%>" class="card-image" id="image<%= index+1 %>_3"
                                    alt="Product Image 3">
                                <div class="dot-navigation">
                                    <span class="dot" data-index="0"></span>
                                    <span class="dot" data-index="1"></span>
                                    <span class="dot" data-index="2"></span>
                                </div>
                                <div class="text-overlay">
                                    <h3>
                                        <%= Product.productName %>
                                    </h3>
                                    <div class="prices">
                                        <% if (Product.discountedPercentage> 0) { %>
                                            <span class="current-price">₹ <%= Product.discountedPrice %></span>
                                            <span class="original-price">₹ <%= Product.originalPrice %></span>
                                            <% } else { %>
                                                <span class="current-price">₹ <%= Product.originalPrice %></span>
                                                <% } %>
                                    </div>
                                </div>
                            </div>
                        </a>
                    </div>
                    <% }); %>
            </div>
        </div>

        <!-- Normal Products Section -->
        <div class="normal-products">
            <!-- <h2>Normal Products</h2> -->
            <div class="row">
                <% normalProducts.slice(0, 2).forEach((Product, index)=> { %>
                    <div class="card-container">
                        <a href="/product/<%= Product._id %>">
                            <div class="card" id="interactive-card<%=index + 1 %>">
                                <img src="<%= Product.images[0]%>" class="card-image active"
                                    id="default<%= index + 1 %> " alt="Default image">
                                <img src="<%= Product.images[1]%>" class="card-image" id="image<%= index + 1 %>_1"
                                    alt="Product Image 1">
                                <img src="<%= Product.images[2]%>" class="card-image" id="image<%= index + 1 %>_2"
                                    alt="Product Image 2">
                                <img src="<%= Product.images[3]%>" class="card-image" id="image<%= index+1 %>_3"
                                    alt="Product Image 3">
                                <div class="dot-navigation">
                                    <span class="dot" data-index="0"></span>
                                    <span class="dot" data-index="1"></span>
                                    <span class="dot" data-index="2"></span>
                                </div>
                                <div class="text-overlay">
                                    <h3>
                                        <%= Product.productName %>
                                    </h3>
                                    <div class="prices">
                                        <% if (Product.discountedPercentage> 0) { %>
                                            <span class="current-price">₹ <%= Product.discountedPrice %></span>
                                            <span class="original-price">₹ <%= Product.originalPrice %></span>
                                            <% } else { %>
                                                <span class="current-price">₹ <%= Product.originalPrice %></span>
                                                <% } %>
                                    </div>
                                </div>
                            </div>
                        </a>
                    </div>
                    <% }); %>
            </div>
        </div>
    </div>
    <footer>
        <%- include('partials/footer') %>
    </footer>

    <script src="/js/cards.js"></script>
</body>

</html>