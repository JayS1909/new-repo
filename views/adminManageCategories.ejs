<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manage Categories | Admin Dashboard</title>
    <link rel="stylesheet" href="/css/admin.css">
</head>
<body>
    <div class="admin-container">
        <nav class="admin-nav">
            <h1>Admin Dashboard</h1>
            <ul>
                <li><a href="/admin">Back to Dashboard</a></li>
            </ul>
        </nav>
        <div class="content">
            <h2>Manage Product Categories</h2>
            <p>Here you can view, add, or disable product categories for EXTRAALAYER.</p>
            <div style="background: white; padding: 20px; border-radius: 8px;">
                <h3>Current Categories</h3>
                <ul style="list-style: none; padding: 0;">
                    <li style="padding: 10px; border-bottom: 1px solid #eee;">Oversized T-Shirts <button style="float:right;">Edit</button></li>
                    <li style="padding: 10px; border-bottom: 1px solid #eee;">Hoodies <button style="float:right;">Edit</button></li>
                    <li style="padding: 10px; border-bottom: 1px solid #eee;">Cargo Pants <button style="float:right;">Edit</button></li>
                </ul>
                <button style="margin-top: 20px; padding: 10px; background: #000; color: white;">+ Add New Category</button>
            </div>
        </div>
    </div>
</body>
</html>
