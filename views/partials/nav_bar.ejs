<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <!-- SEO and OpenGraph -->
    <meta name="description" content="EXTRAALAYER - Premium Gen-Z men's streetwear. Oversized t-shirts, hoodies, acid wash, anime prints and dark luxury aesthetics. Layer Up. Stand Out.">
    <meta name="keywords" content="streetwear, mens fashion, oversized t-shirts, hoodies, acid wash, anime streetwear, dark luxury">
    <meta property="og:title" content="<%= typeof title !== 'undefined' ? title : 'EXTRAALAYER | Layer Up. Stand Out.' %>">
    <meta property="og:description" content="Premium Gen-Z men's streetwear.">
    <meta property="og:image" content="/images/placeholder_hero.jpg">
    <meta property="og:url" content="https://extraalayer.com">
    <link rel="canonical" href="https://extraalayer.com">

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="<%= typeof title !== 'undefined' ? title : 'EXTRAALAYER | Layer Up. Stand Out.' %>">
    <meta name="twitter:description" content="Premium Gen-Z men's streetwear.">
    <meta name="twitter:image" content="/images/placeholder_hero.jpg">

    <title><%= typeof title !== 'undefined' ? title : 'EXTRAALAYER' %></title>
    <link rel="stylesheet" href="/css/nav_bar.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"> <!-- Fixed link -->
    <style>
        .navbar {
            background-color: #0a0a0a !important;
            border-bottom: 1px solid #333;
        }
        .extraalayer-logo {
            display: inline-block;
            font-size: 24px;
            font-weight: 800;
            letter-spacing: 2px;
            color: #fff;
            text-decoration: none;
            text-transform: uppercase;
        }
        .bi-person { fill: #fff; }
        .cart-toggle img { filter: invert(1); } /* Invert generic black icons if any */
        .cart-panel { background-color: #1a1a1a; color: #f0f0f0; }
        .cart-panel-header, .cart-panel-footer { border-color: #333; }
        .sideNav { background-color: #1a1a1a; }
        .sideNav ul li a { color: #f0f0f0; }
    </style>
</head>
<body>
    <nav class="navbar">
        <div class="brand-logo" style="flex:1; padding-left: 20px;">
            <a href="/" class="extraalayer-logo">
                EXTRAALAYER
            </a>
        </div>

        <div class="profile">
            <% if (user) { %>
                <!-- Profile Icon -->
                <a href="javascript:void(0)" class="profile-btn" onclick="toggleDropdown()">
                    <svg xmlns="http://www.w3.org/2000/svg" width="25" height="60" fill="currentColor" class="bi bi-person" viewBox="0 0 16 16">
                        <path d="M8 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6m2-3a2 2 0 1 1-4 0 2 2 0 0 1 4 0m4 8c0 1-1 1-1 1H3s-1 0-1-1 1-4 6-4 6 3 6 4m-1-.004c-.001-.246-.154-.986-.832-1.664C11.516 10.68 10.289 10 8 10s-3.516.68-4.168 1.332c-.678.678-.83 1.418-.832 1.664z"/>
                    </svg>
                </a>
                <!-- Dropdown Menu -->
                <div id="profileMenu" class="dropdown-content">
                    <span style="color: black; padding: 12px 16px; display: block;">Welcome, <%= user.fullName %>!</span>
                    <span onclick="window.location.href='/displayAuthOrders'">Order History</span>
                    <span href="/logout" onclick="logout(event)">Logout</span>
                </div>
            <% } else { %>
                <!-- Redirect to Login -->
                <a href="/login" class="login-link">
                    <svg xmlns="http://www.w3.org/2000/svg" width="25" height="60" fill="currentColor" class="bi bi-person" viewBox="0 0 16 16">
                        <path d="M8 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6m2-3a2 2 0 1 1-4 0 2 2 0 0 1 4 0m4 8c0 1-1 1-1 1H3s-1 0-1-1 1-4 6-4 6 3 6 4m-1-.004c-.001-.246-.154-.986-.832-1.664C11.516 10.68 10.289 10 8 10s-3.516.68-4.168 1.332c-.678.678-.83 1.418-.832 1.664z"/>
                    </svg>
                </a>
            <% } %>
        </div>

        <!-- Cart icon -->
        <div class="cart">
            <a href="javascript:void(0)" id="cart-toggle">
                <img src="/images/icons8-shopping-bag-50.png" width="20" height="20" alt="shopping cart bag">
            </a>
            <!-- Cart side panel -->
            <div class="cart-panel" id="cart-panel">
                <div class="cart-panel-header">
                    <h5>Your Cart</h5>
                    <a href="javascript:void(0)" id="cart-close">&times;</a>
                </div>
                <div class="cart-panel-content">
                    <!-- Cart items will be listed here -->
                    <ul id="cart-items">
                        <!-- Items will be dynamically added here -->
                    </ul>
                </div>
                <div id="cart-panel-footer" class="cart-panel-footer">
                    <div class="cart-total">
                        <p>Total: Rs. <span id="cart-total"></span></p>
                    </div>
                    <button id="checkout-btn" class="checkout-btn">Proceed to Checkout</button>
                </div>
                <div class="login-prompt">
                    <p>Don't miss out on exclusive member benefits.</p>
                    <p><a href="/login" class="login-link">Log in</a> to get started!</p>
                </div>
            </div>
            <div class="overlay" id="overlay"></div>
        </div>
    </nav>

    <!-- This is a division of a side nav of categories -->
    <div id="Nav-overlay" class="Nav-overlay" onclick="closeNav()"></div>
    <div id="mySideNav" class="sideNav">
        <ul class="nav" id="nav">
            <!-- Phase 2 taxonomy implementation: Men's streetwear only -->
            <li><a href="/viewAll?category=Oversized T-Shirts">Oversized T-Shirts</a></li>
            <li><a href="/viewAll?category=Hoodies">Hoodies</a></li>
            <li><a href="/viewAll?category=Sweatshirts">Sweatshirts</a></li>
            <li><a href="/viewAll?category=Cargo Pants">Cargo Pants</a></li>
            <li><a href="/viewAll?collectionTheme=Anime">Anime Collection</a></li>
            <li><a href="/viewAll?collectionTheme=Acid Wash">Acid Wash Collection</a></li>
            <li><a href="/viewAll">Shop All</a></li>
        </ul>
    </div>
    <script src="/js/nav_bar.js" defer></script>
    <script src="/js/productDetails.js" defer></script>
    <script src="https://checkout.razorpay.com/v1/checkout.js"></script>
</body>
</html>