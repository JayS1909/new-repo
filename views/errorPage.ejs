<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <style>
    body {
      font-family: Arial, sans-serif;
      background-color: #f9f9f9;
      display: flex;
      align-items: center;
      justify-content: center;
      height: 100vh;
      margin: 0;
    }
    .error-container {
      text-align: center;
      background: #fff;
      padding: 40px 20px;
      border-radius: 8px;
      box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
    }
    h1 {
      color: #ff4757;
      font-size: 2.5rem;
      margin: 0 0 20px;
    }
    p {
      color: #333;
      font-size: 1.2rem;
      margin: 0 0 20px;
    }
    a {
      text-decoration: none;
      color: #fff;
      background-color: #1e90ff;
      padding: 10px 20px;
      border-radius: 5px;
      transition: background-color 0.3s;
    }
    a:hover {
      background-color: #3742fa;
    }
  </style>
</head>
<body>
  <div class="error-container">
    <h1><%= title %></h1>
    <p><%= message %></p>
    <a href="/">Go to Homepage</a>
  </div>
</body>
</html>
