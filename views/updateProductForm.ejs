<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Update Product</title>
    <link rel="stylesheet" href="/css/addProducts.css">
</head>
<body>
    <div class="container">
        <h1>Update Product Details</h1>
        <form action="/products/update" method="POST">
            <input type="hidden" name="sku" value="<%= product.sku %>">
            <div class="form-group">
                <label for="productName">Product Name:</label>
                <input type="text" id="productName" name="productName" value="<%= product.productName %>" required>
            </div>
            <div class="form-group">
                <label for="originalPrice">Original Price:</label>
                <input type="number" id="originalPrice" name="originalPrice" value="<%= product.originalPrice%>" required>
            </div>

            <div class="form-group">
                <label for="discountedPercentage">Discount Percentage:</label>
                <input type="number" id="discountedPercentage" name="discountedPercentage" value="<%= product.discountedPercentage %>" required>
            </div>
        
            <div class="form-group">
                <label for="sizeXS">Size XS Quantity:</label>
                <input type="number" id="sizeXS" name="sizes[XS]" value="<%= product.sizes.get('XS') || 0 %>" required min="0">
            </div>

            <div class="form-group">
                <label for="sizeS">Size S Quantity:</label>
                <input type="number" id="sizeS" name="sizes[S]" value="<%= product.sizes.get('S') %>" required min="0">
            </div>

            <div class="form-group">
                <label for="sizeM">Size M Quantity:</label>
                <input type="number" id="sizeM" name="sizes[M]" value="<%= product.sizes.get('M') %>" required min="0">
            </div>

            <div class="form-group">
                <label for="sizeL">Size L Quantity:</label>
                <input type="number" id="sizeL" name="sizes[L]" value="<%= product.sizes.get('L') %>" required min="0">
            </div>

            <div class="form-group">
                <label for="sizeXL">Size XL Quantity:</label>
                <input type="number" id="sizeXL" name="sizes[XL]" value="<%= product.sizes.get('XL') %>" required min="0">
            </div>

            <div class="form-group">
                <label for="sizeXXL">Size XXL Quantity:</label>
                <input type="number" id="sizeXXL" name="sizes[XXL]" value="<%= product.sizes.get('XXL') %>" required min="0">
            </div>

            <div class="form-group">
                <label for="category">Category:</label>
                <select id="category" name="category" required>
                    <option value="Oversized T-Shirts" <%= product.category === 'Oversized T-Shirts' ? 'selected' : '' %>>Oversized T-Shirts</option>
                    <option value="Oversized Shirts" <%= product.category === 'Oversized Shirts' ? 'selected' : '' %>>Oversized Shirts</option>
                    <option value="Shirts" <%= product.category === 'Shirts' ? 'selected' : '' %>>Shirts</option>
                    <option value="T-Shirts" <%= product.category === 'T-Shirts' ? 'selected' : '' %>>T-Shirts</option>
                    <option value="Hoodies" <%= product.category === 'Hoodies' ? 'selected' : '' %>>Hoodies</option>
                    <option value="Sweatshirts" <%= product.category === 'Sweatshirts' ? 'selected' : '' %>>Sweatshirts</option>
                    <option value="Cargo Pants" <%= product.category === 'Cargo Pants' ? 'selected' : '' %>>Cargo Pants</option>
                    <option value="Joggers" <%= product.category === 'Joggers' ? 'selected' : '' %>>Joggers</option>
                    <option value="Jeans" <%= product.category === 'Jeans' ? 'selected' : '' %>>Jeans</option>
                    <option value="Jackets" <%= product.category === 'Jackets' ? 'selected' : '' %>>Jackets</option>
                    <option value="Co-Ord Sets" <%= product.category === 'Co-Ord Sets' ? 'selected' : '' %>>Co-Ord Sets</option>
                    <option value="Accessories" <%= product.category === 'Accessories' ? 'selected' : '' %>>Accessories</option>
                </select>
            </div>

            <div class="form-group">
                <label for="subcategory">Subcategory:</label>
                <input type="text" id="subcategory" name="subcategory" value="<%= product.subcategory %>">
            </div>

            <div class="form-group">
                <label for="collectionTheme">Collection Theme:</label>
                <select id="collectionTheme" name="collectionTheme">
                    <option value="General" <%= product.collectionTheme === 'General' ? 'selected' : '' %>>General</option>
                    <option value="Anime" <%= product.collectionTheme === 'Anime' ? 'selected' : '' %>>Anime</option>
                    <option value="Acid Wash" <%= product.collectionTheme === 'Acid Wash' ? 'selected' : '' %>>Acid Wash</option>
                    <option value="Minimal" <%= product.collectionTheme === 'Minimal' ? 'selected' : '' %>>Minimal</option>
                    <option value="Graphic" <%= product.collectionTheme === 'Graphic' ? 'selected' : '' %>>Graphic</option>
                    <option value="Typography" <%= product.collectionTheme === 'Typography' ? 'selected' : '' %>>Typography</option>
                    <option value="Vintage Wash" <%= product.collectionTheme === 'Vintage Wash' ? 'selected' : '' %>>Vintage Wash</option>
                    <option value="Premium Essentials" <%= product.collectionTheme === 'Premium Essentials' ? 'selected' : '' %>>Premium Essentials</option>
                    <option value="New Arrivals" <%= product.collectionTheme === 'New Arrivals' ? 'selected' : '' %>>New Arrivals</option>
                    <option value="Best Sellers" <%= product.collectionTheme === 'Best Sellers' ? 'selected' : '' %>>Best Sellers</option>
                    <option value="Limited Drops" <%= product.collectionTheme === 'Limited Drops' ? 'selected' : '' %>>Limited Drops</option>
                </select>
            </div>

            <div class="form-group">
                <label for="isFeatured">Featured:</label>
                <input type="checkbox" id="isFeatured" name="isFeatured" <%= product.isFeatured ? 'checked' : '' %> >
            </div>

            <button type="submit" class="btn">Update Product</button>
        </form>
    </div>
</body>
</html>
