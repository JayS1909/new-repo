<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manage Reviews | Admin Dashboard</title>
    <link rel="stylesheet" href="/css/admin.css">
</head>
<body>
    <div class="admin-container">
        <nav class="admin-nav">
            <h1>Admin Dashboard</h1>
            <ul>
                <li><a href="/admin">Back to Dashboard</a></li>
            </ul>
        </nav>
        <div class="content">
            <h2>Manage Customer Reviews</h2>
            <div style="background: white; padding: 20px; border-radius: 8px;">
                <p>Approve, reject, or delete customer reviews.</p>
                <table style="width: 100%; text-align: left; border-collapse: collapse; margin-top: 15px;">
                    <tr style="border-bottom: 2px solid #ddd;">
                        <th style="padding: 10px;">Product</th>
                        <th style="padding: 10px;">User</th>
                        <th style="padding: 10px;">Rating</th>
                        <th style="padding: 10px;">Comment</th>
                        <th style="padding: 10px;">Action</th>
                    </tr>
                    <!-- Dynamic rendering would go here -->
                    <tr>
                        <td style="padding: 10px;" colspan="5">No pending reviews.</td>
                    </tr>
                </table>
            </div>
        </div>
    </div>
</body>
</html>
