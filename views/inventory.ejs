<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Inventory Management</title>
    <link rel="stylesheet" href="/css/inventory.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap" rel="stylesheet">
</head>

<body>
    <header>
        <h1>👕 EXTRAALAYER Oversized Tees</h1>
        <p class="subtitle">Your ultimate destination for stylish comfort and effortless style.</p>
    </header>
    <div class="table-container">
        <table id="inventoryTable" aria-label="Inventory Management Table">
            <thead>
                <tr>
                    <th rowspan="2">Product Name</th>
                    <th rowspan="2">SKU Number</th>
                    <th colspan="6">Sizes & Quantity Available</th>
                </tr>
                <tr>
                    <th>XS</th>
                    <th>S</th>
                    <th>M</th>
                    <th>L</th>
                    <th>XL</th>
                    <th>Total</th>
                </tr>
            </thead>
            <tbody>
                <!-- Dynamic data population goes here -->
            </tbody>
        </table>
    </div>

    <footer class="footer">
        <p>&copy; 2024 <span class="brand">EXTRAALAYER</span>. Wear the Trend, Own the Moment.✨</p>
    </footer>

    <script src="/js/inventory.js"></script>
</body>

</html>
