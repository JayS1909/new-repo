<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/cards.css">
    <link rel="stylesheet" href="/css/navbar.css">
    <link rel="stylesheet" href="/css/styles.css">
    <link rel="stylesheet" href="/css/footer.css">
    <link rel="icon" href="/images/Vintiti small logo.jpg">
    <title>Vintiti Oversized T-Shirts - Modern Streetwear for Men & Women</title>
</head>
<body>
    <%- include('partials/nav_bar') %>


    <div class="video-container">
        <!-- Video for larger screens -->
        <video class="video-large" autoplay muted loop playsinline>
          <source src="./images/mainweb.mov" type="video/mp4">
          Your browser does not support the video tag.
        </video>
    
        <!-- Video for smaller screens -->
        <video class="video-small" autoplay muted loop playsinline>
          <source src="./images/main.mov" type="video/mp4">
          Your browser does not support the video tag.
        </video>
      </div>



    <div class="featured-products">
        <h1>FEATURED PRODUCTS</h1>
    </div>

    <div class="featured">
        <div class="cards-container">
            <% products.forEach((Product, index) => { %>
                <a href="/product/<%= Product._id %>">
                    <div class="card" id="interactive-card<%=index + 1 %>">
                        <img src="<%= Product.images[0]%>" class="card-image active" id="default<%= index + 1 %> " alt="Vintiti Oversized T-shirt image">
                        <img src="<%= Product.images[1]%>" class="card-image" id = "image<%= index + 1 %>_1" alt="Vintiti Oversized T-shirt image">
                        <img src="<%= Product.images[2]%>" class="card-image" id="image<%= index + 1 %>_2" alt="Vintiti Oversized T-shirt image">
                        <img src="<%= Product.images[3]%>" class="card-image" id="image<%= index+1 %>_3" alt="Vintiti Oversized T-shirt image">
                        <div class="dot-navigation">
                            <span class="dot" data-index="0"></span>
                            <span class="dot" data-index="1"></span>
                            <span class="dot" data-index="2"></span>
                        </div>
                        <div class="text-overlay">
                            <h3 style="font-weight: bold;"><%= Product.productName %></h3>
                            <div class="prices">
                                <% if (Product.discountedPercentage > 0) { %>
                                    <span class="current-price">₹ <%= Product.discountedPrice %></span>
                                    <span class="original-price">₹ <%= Product.originalPrice %></span>
                                    <span class="discount">₹ <%= Product.originalPrice - Product.discountedPrice %> OFF</span>
                                <% } else { %>
                                    <span class="current-price">₹ <%= Product.originalPrice %></span>
                                <% } %>
                            </div>
                        </div>
                    </div>
                </a>   
           <% }); %> 
        </div>
    </div>
    <!-- viewAll-button.ejs -->
    <div class="moreButton">
        <a href="/viewAll" class="shimmer-button" id="shimmerButton">
            <span class="button-text">VIEW ALL</span>
            <span class="shimmer" id="shimmer"></span>
        </a>
    </div>
    <div class="video-container">
        <video autoplay loop muted playsinline class="vcc">
            <source src="/images/street.mp4" type="video/mp4">
        </video>
    </div>


    <!-- Brand Section -->
    <section class="brand" id="brand">
        <div class="brand">
            <div class="section__container">
                <div class="split-screen">
                    <!-- Image side - 65% width -->
                    <div class="image-side">
                        <div class="image-sequence" id="image-sequence">
                            <img src="/images/s1.JPEG" class="image active" alt="Group of models wearing Vintiti unisex oversized t-shirts, featuring vibrant designs and casual streetwear styles, showcasing the brand's diverse and inclusive fashion appeal.">
                            <img src="/images/s2.JPEG" class="image" alt="Vintiti oversized t-shirts styled by four models, showcasing 'Exotic' tropical prints, 'Too Unique' bunny design, and minimalist logo prints.">
                            <img src="/images/3d.jpg" class="image" alt="Modern unisex streetwear collection by Vintiti, featuring oversized t-shirts in bold and creative designs, modeled by six individuals.">
                            <div class="overlay"></div> <!-- Dark Overlay -->
                        </div>
                    </div>
                    <!-- Text side - 35% width -->
                    <div class="text-side">
                        <div class="text-box">
                            <div class="banner-text">
                                <h1>VINTITI</h1>
                                <h2>Streetwear for the Fearless</h2>
                                <p>Welcome to VINTITI, where oversized fits meet premium puff prints and 100% cotton comfort. Designed for trendsetters and rule-breakers, our collection redefines streetwear with style that stands out.</p>
                                <p>With Pan-India delivery and more drops coming soon, this is just the start of a journey where fashion makes a statement and sets a lifestyle.</p>
                                <p>Be bold. Be VINTITI.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
    
    
<script>
let currentIndex = 0;
const images = document.querySelectorAll('.image');

function showNextImage() {
    // Remove active class from current image
    images[currentIndex].classList.remove('active');
    
    // Update index to the next image
    currentIndex = (currentIndex + 1) % images.length;
    
    // Add active class to the next image
    images[currentIndex].classList.add('active');
}

// Change image every 3 seconds
setInterval(showNextImage, 3000);
</script>
    
    
    <div class="marquee">
        <div class="marquee-content">
            <% for (let i = 0; i < 100; i++) { %>
                <span style="font-weight: bold;">STREETWEAR&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span>
            <% } %>
        </div>
        <div class="marquee-content">
            <% for (let i = 0; i < 100; i++) { %>
                <span style="font-weight: bold;">STREETWEAR&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span>
            <% } %>
        </div>
    </div>
   

    <section class="blog" id="blog">
        <div class="container">
            <div class="title">
                <h2>Instagram</h2>
                <p>Feeds And Reels</p>
            </div>
            <div class="section__container portfolio__container">
                <div class="portfolio__grid">
                    <% const posts = [
                        { img: '/images/coffee.jpeg', link: 'https://www.instagram.com/reel/DB835_bKjw2/?igsh=cXdyaTR2c2QzaW9k' },
                        { img: '/images/street.jpeg', link: 'https://www.instagram.com/reel/DCg7vJtMLG_/?igsh=cGhpZGtldGZ3azJu' },
                        { img: '/images/girl.jpeg', link: 'https://www.instagram.com/reel/DBWTqFjKu7N/?igsh=dWlrbWRlMTRmZG9i' },
                        { img: '/images/Seebeyond.png', link: 'https://www.instagram.com/p/DCy3qj1MwUg/' },
                        { img: '/images/dfs.png', link: 'https://www.instagram.com/p/DCMXcDpMK28/' },
                        { img: '/images/rabbit.png', link: 'https://www.instagram.com/p/DEUvg5NT75k/' }
                    ]; %>
                    <% posts.forEach(post => { %>
                        <a href="<%= post.link %>" target="_blank" class="portfolio__card">
                            <img src="<%= post.img %>" alt="portfolio" />
                            <div class="portfolio__content">
                                <p>VIEW POST</p>
                            </div>
                        </a>
                    <% }); %>
                </div>
            </div>
        </div>
    </section>
    



