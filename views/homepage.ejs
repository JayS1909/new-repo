<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/cards.css">
    <link rel="stylesheet" href="/css/styles.css">
    <link rel="stylesheet" href="/css/footer.css">
    <title>EXTRAALAYER | Layer Up. Stand Out. | Premium Men's Streetwear</title>
    <style>
        body {
            background-color: #0a0a0a;
            color: #f0f0f0;
            font-family: 'Helvetica Neue', Arial, sans-serif;
            margin: 0;
            padding: 0;
        }
        .hero-banner {
            height: 80vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(to bottom, rgba(0,0,0,0.4), #0a0a0a), url('/images/placeholder_hero.jpg') center/cover;
            text-align: center;
        }
        .hero-banner h1 {
            font-size: 4rem;
            letter-spacing: 5px;
            text-transform: uppercase;
            margin-bottom: 0.5rem;
        }
        .hero-banner p {
            font-size: 1.5rem;
            letter-spacing: 2px;
            color: #d0d0d0;
        }
        .section-title {
            text-align: center;
            margin: 4rem 0 2rem;
            font-size: 2rem;
            text-transform: uppercase;
            letter-spacing: 3px;
        }
        .category-grid {
            display: flex;
            justify-content: center;
            gap: 20px;
            flex-wrap: wrap;
            padding: 20px 5%;
        }
        .category-box {
            border: 1px solid #333;
            padding: 30px;
            color: #fff;
            text-decoration: none;
            text-align: center;
            flex: 1;
            min-width: 200px;
            background-color: #1a1a1a;
            transition: all 0.3s ease;
        }
        .category-box:hover {
            background-color: #f0f0f0;
            color: #0a0a0a;
            transform: translateY(-5px);
        }
        .btn-view-all {
            display: inline-block;
            padding: 15px 40px;
            background-color: #f0f0f0;
            color: #0a0a0a;
            text-decoration: none;
            font-weight: bold;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-top: 20px;
            transition: all 0.3s ease;
        }
        .btn-view-all:hover {
            background-color: #fff;
            box-shadow: 0 0 10px rgba(255,255,255,0.2);
        }
    </style>
</head>
<body>
    <%- include('partials/nav_bar') %>

    <section class="hero-banner">
        <div>
            <h1>EXTRAALAYER</h1>
            <p>Layer Up. Stand Out.</p>
        </div>
    </section>

    <section class="shop-by-category">
        <h2 class="section-title">Shop By Category</h2>
        <div class="category-grid">
            <a href="/viewAll?category=Oversized T-Shirts" class="category-box">OVERSIZED T-SHIRTS</a>
            <a href="/viewAll?category=Hoodies" class="category-box">HOODIES</a>
            <a href="/viewAll?category=Cargo Pants" class="category-box">CARGO PANTS</a>
            <a href="/viewAll?category=Accessories" class="category-box">ACCESSORIES</a>
        </div>
    </section>

    <section class="collections">
        <h2 class="section-title">Our Collections</h2>
        <div class="category-grid">
            <a href="/viewAll?collectionTheme=Anime" class="category-box">
                <h3>ANIME</h3>
            </a>
            <a href="/viewAll?collectionTheme=Acid Wash" class="category-box">
                <h3>ACID WASH</h3>
            </a>
            <a href="/viewAll?collectionTheme=Minimal" class="category-box">
                <h3>MINIMAL</h3>
            </a>
        </div>
    </section>

    <div style="text-align:center; padding: 60px 20px;">
        <h2 style="font-size: 2.5rem; letter-spacing: 2px; text-transform: uppercase; margin-bottom: 30px;">Premium Men's Streetwear</h2>
        <a href="/viewAll" class="btn-view-all">VIEW ALL PRODUCTS</a>
    </div>

    <!-- FOOTER SECTION -->
    <%- include('partials/footer') %>

    <script src="/js/nav_bar.js"></script>
</body>
</html>
