<body>
    <div class="container">
        <h1>EXTRAALAYER</h1>
        <h2>Delete Product</h2>
        <p class="instruction">Enter the SKU to quickly delete the product.</p>
        <form id="deleteProductForm">
            <div class="form-group">
                <label for="sku">Product SKU:</label>
                <input type="text" id="sku" name="sku" required>
            </div>
            <button type="submit" class="btn">Delete Product</button>
        </form>

        <div id="responseMessage"></div>
    </div>

    <script>
        document.getElementById('deleteProductForm').addEventListener('submit', async function(event) {
            event.preventDefault();

            const sku = document.getElementById('sku').value;

            try {
                const response = await fetch('/products/delete', {
                    method: 'DELETE',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({ sku })
                });

                const result = await response.json();

                if (response.ok) {
                    document.getElementById('responseMessage').innerText = result.message;
                    document.getElementById('responseMessage').style.color = 'green';
                } else {
                    document.getElementById('responseMessage').innerText = `Error: ${result.message}`;
                    document.getElementById('responseMessage').style.color = 'red';
                }
            } catch (error) {
                document.getElementById('responseMessage').innerText = `Error: ${error.message}`;
                document.getElementById('responseMessage').style.color = 'red';
            }
        });
    </script>
</body>
