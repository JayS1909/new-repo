<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manage Coupons | Admin Dashboard</title>
    <link rel="stylesheet" href="/css/admin.css">
</head>
<body>
    <div class="admin-container">
        <nav class="admin-nav">
            <h1>Admin Dashboard</h1>
            <ul>
                <li><a href="/admin">Back to Dashboard</a></li>
            </ul>
        </nav>
        <div class="content">
            <h2>Manage Discount Coupons</h2>
            <div style="background: white; padding: 20px; border-radius: 8px;">
                <button style="margin-bottom: 20px; padding: 10px; background: #000; color: white;">+ Create New Coupon</button>
                <table style="width: 100%; text-align: left; border-collapse: collapse;">
                    <tr style="border-bottom: 2px solid #ddd;">
                        <th style="padding: 10px;">Code</th>
                        <th style="padding: 10px;">Discount</th>
                        <th style="padding: 10px;">Valid Until</th>
                        <th style="padding: 10px;">Uses</th>
                        <th style="padding: 10px;">Action</th>
                    </tr>
                    <tr>
                        <td style="padding: 10px;" colspan="5">No active coupons.</td>
                    </tr>
                </table>
            </div>
        </div>
    </div>
</body>
</html>
